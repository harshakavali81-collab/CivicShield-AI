# Local development only; NEVER commit real secrets.
DATABASE_URL=sqlite:///./civicshield.db
INCIDENT_SUBMISSIONS_ENABLED=false
RESPONDER_API_KEY=
CIVICSHIELD_MODEL_PATH=
VITE_API_BASE=

# Optional source-backed modeled weather (non-official; noncommercial Open-Meteo terms)
OPEN_METEO_ENABLED=false
# Local only: set when enabling incident submissions
REPORTER_API_KEY=
# Override default localhost-only Docker Postgres password before starting new DB
POSTGRES_PASSWORD=

# Hosted deployment (requires real identity provider; no secrets in Git)
APP_ENV=local
AUTH_MODE=demo_key
CORS_ORIGINS=
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_ROLES_CLAIM=roles
OIDC_RESPONDER_ROLE=civicshield-responder
# Required for production OIDC audit pseudonyms (min 32 characters, private)
AUDIT_HASH_SECRET=
# IMD: only enable after permission and actual API access
IMD_API_ENABLED=false
IMD_API_BEARER_TOKEN=

# Frontend Vite build-time variables (set for hosted browser OIDC)
VITE_AUTH_MODE=
VITE_OIDC_AUTHORITY=
VITE_OIDC_CLIENT_ID=
VITE_OIDC_SCOPE=
VITE_API_BASE=
